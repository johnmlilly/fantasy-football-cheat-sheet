{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fantasy-football-cheat-sheet",
  "compatibility_date": "2026-08-24",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
